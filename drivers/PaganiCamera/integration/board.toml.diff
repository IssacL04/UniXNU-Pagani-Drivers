--- a/board.toml	(UniXNU-Pagani_SM8750-gpu)
+++ b/board.toml
@@ [components]
-include = [..., "PaganiBt", "PaganiTorch"]
+include = [..., "PaganiBt", "PaganiCamera", "PaganiTorch"]
@@ [kernel] archives
   "component:PaganiBt",
+  # The camera (pagani-cam=N, default off: 1 survey, 2 clock controllers read, 3 power domain and CCI version, 4 telephoto sensor ID), appended to the A830 archive
+  # like the others; Stage7Probe calls pagani_camera_start after the Bluetooth.
+  "component:PaganiCamera",
   # The torch (pagani-torch=1; 2 dry run; default off), appended to the A830 archive like the others; Stage7Probe calls pagani_torch_start
@@ [payload] kernel_args
 # 不变：默认镜像里驱动是关的。阶段 2 的测试镜像 A830_EXTRA_ARGS="pagani-cam=N"（13 字节，够放）。阶段 1a 要 pagani-torch=1 pagani-torch-ios=1（34 字节），命令行只剩 22 字节，要先腾 12 字节。
